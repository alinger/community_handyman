# ============================================================
# 环境变量模板：复制为 .env 后填写真实值（.env 已被 .gitignore 忽略）
# 只需修改 MYSQL_DSN 里的 CHANGE_ME 为你的 MySQL root 密码
# 密码含 @ : / ? # 等特殊字符时，需要 URL 编码后再填：
#   @  -> %40    :  -> %3A    /  -> %2F    ?  -> %3F    #  -> %23
# ============================================================

# ---------- 数据库 ----------
MYSQL_DSN=root:your_password@tcp(127.0.0.1:3306)/community_handyman?charset=utf8mb4&parseTime=True&loc=Local

# ---------- Redis（时段库存扣减用，未启用可留空）----------
REDIS_PASSWORD=

# ---------- 微信支付（商户号下来后再填）----------
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

# ---------- 对象存储（服务记录图片与视频）----------
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- 后台登录 token 签名密钥（留空用开发默认值，生产必填）----------
AUTH_SECRET=

# ---------- 后台初始账号密码（仅 make seed-admin 使用）----------
ADMIN_PASSWORD=
