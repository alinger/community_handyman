# ============================================================
# 环境变量模板：复制为 .env 后填写真实值（.env 已被 .gitignore 忽略）
# 只需修改 MYSQL_DSN 里的 CHANGE_ME 为你的 MySQL root 密码
# 密码含 @ : / ? # 等特殊字符时，需要 URL 编码后再填：
#   @  -> %40    :  -> %3A    /  -> %2F    ?  -> %3F    #  -> %23
# ============================================================

# ---------- 数据库 ----------
MYSQL_DSN=root:your_password@tcp(127.0.0.1:3306)/community_handyman?charset=utf8mb4&parseTime=True&loc=Local

# ---------- Redis（时段库存扣减用，未启用可留空）----------
REDIS_PASSWORD=

# ---------- 微信支付（商户号下来后再填）----------
WECHAT_APP_ID=
# 小程序 AppSecret（微信授权登录用），与支付密钥无关
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

# ---------- 对象存储（服务记录图片与视频）----------
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- 后台登录 token 签名密钥（留空用开发默认值，生产必填）----------
AUTH_SECRET=

# ---------- 后台初始账号密码（仅 make seed-admin 使用）----------
ADMIN_PASSWORD=

# ---------- 阿里云短信（验证码登录/找回密码）----------
# provider 留空：dev 自动用 console（验证码打日志），生产自动用 aliyun
# 留空可本地联调；要真机收短信时填 aliyun 与下面四项
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 短信签名，已在阿里云控制台审核通过的签名名称，如：邻有回应
SMS_SIGN_NAME=
# 模板 CODE，模板内容需含 ${code} 变量，如：SMS_123456789
SMS_TEMPLATE_CODE=
# 可选：专有云/海外区域接入地址，留空用官方默认
SMS_ENDPOINT=
